      "isDeleted": false,
      "boundElements": null,
      "updated": 1781845223607,
      "link": null,
      "locked": false,
      "text": "A rate limiter controls how many requests a client can make within a specific timeframe.\nIt acts like a traffic controller for your API - allowingm, for example, 100 requests per minute from a user,\nthen rejecting excess requests with an HTTP 429 \"Too Many Requests\" response. Rate limiters prevent abuse,\nprotect your servers from being overwhelmed by bursts of traffic, and ensure fair usage accross all users.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A rate limiter controls how many requests a client can make within a specific timeframe.\nIt acts like a traffic controller for your API - allowingm, for example, 100 requests per minute from a user,\nthen rejecting excess requests with an HTTP 429 \"Too Many Requests\" response. Rate limiters prevent abuse,\nprotect your servers from being overwhelmed by bursts of traffic, and ensure fair usage accross all users.",
      "autoResize": true,
      "lineHeight": 1.25
    }

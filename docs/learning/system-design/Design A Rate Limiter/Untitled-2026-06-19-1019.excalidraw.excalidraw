      "seed": 1995626742,
      "version": 377,
      "versionNonce": 1513761462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782189259181,
      "link": null,
      "locked": false,
      "text": "What makes our user Unique? IP, API Key?\nAre the user's authenticated?\nIs it an internal developer application?\nDo authenticated users get higher limits than unauthenticated ones?\nPremium users will get more than authn users\n\n(The above shows the understanding of real world systems)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What makes our user Unique? IP, API Key?\nAre the user's authenticated?\nIs it an internal developer application?\nDo authenticated users get higher limits than unauthenticated ones?\nPremium users will get more than authn users\n\n(The above shows the understanding of real world systems)",
      "autoResize": true,
      "lineHeight": 1.25
    }

    {
      "id": "9PzVtlkyqfShFio_UxH_M",
      "type": "text",
      "x": 1941.5952068629329,
      "y": 1648.576752610318,
      "width": 1032.3184814453125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 1272514998,
      "version": 1093,
      "versionNonce": 441887542,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782189158090,
      "link": null,
      "locked": false,
      "text": "Q1 - Option 3 - The optimal Solution - It lives inside the Gateway or the Load Balancer\nHence each request lands to the gateway, and before forwarding it to the microservice, we check there and then\nthat if this request is even allowed. An analogy can be that this Rate Limiter is like a bouncer in the club who stops\nthe troublemakers even before entering the club and not inside when they cause some trouble,\n\nCon - In the case we had to apply complex rate limiting rules like allow higher rate limits for premium customers,\nit was easier to do that in the Microservice than the gateway as we have very limited information in the gateway \nwhich is the IP, url and any basic auth tokens that may exist in the request.\nPremium users gets 10x requests - can be done by including that they are a premium user in the JWT token.\nHence the MS only serves the request! :)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q1 - Option 3 - The optimal Solution - It lives inside the Gateway or the Load Balancer\nHence each request lands to the gateway, and before forwarding it to the microservice, we check there and then\nthat if this request is even allowed. An analogy can be that this Rate Limiter is like a bouncer in the club who stops\nthe troublemakers even before entering the club and not inside when they cause some trouble,\n\nCon - In the case we had to apply complex rate limiting rules like allow higher rate limits for premium customers,\nit was easier to do that in the Microservice than the gateway as we have very limited information in the gateway \nwhich is the IP, url and any basic auth tokens that may exist in the request.\nPremium users gets 10x requests - can be done by including that they are a premium user in the JWT token.\nHence the MS only serves the request! :)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U4dNSsIz9i9120v8D-LJm",
      "type": "text",
      "x": 3092.5116081504916,
      "y": 215.54730058955204,
      "width": 616.7991943359375,
      "height": 175,
      "angle": 0,
